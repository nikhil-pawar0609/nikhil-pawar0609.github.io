---
import { Picture } from 'astro:assets';
import pune from '../assets/photos/pune-west-skyline.jpg';
import { figures } from '../data/site';
---

<section class="figures" id="hp" aria-labelledby="hp-title">
  <h2 class="heading figures__title" id="hp-title" data-reveal>At HP, 2022–2025</h2>
  <div class="figures__mosaic">
    <figure class="figures__photo" data-reveal="2">
      <Picture
        src={pune}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280]}
        sizes="(min-width: 48em) 64vw, 100vw"
        alt="Pune’s western suburbs from a high floor: a tower under construction in front of rows of apartment blocks fading into haze."
        loading="lazy"
        decoding="async"
      />
      <figcaption>Pune, where I worked for HP, looking west toward Hinjewadi.</figcaption>
    </figure>
    {figures.map((figure, i) => (
      <div class={`figures__tile figures__tile--${i + 1}`} data-reveal={String(i + 3)}>
        <p class="figures__value nums">{figure.value}</p>
        <p class="figures__caption">{figure.caption}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .figures { padding: calc(var(--section) * 0.5) var(--margin) var(--section); }
  .figures__title { margin-bottom: 2.5rem; }
  .figures__mosaic { display: grid; grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; }
  .figures__photo { grid-row: 1 / 3; position: relative; aspect-ratio: 1 / 1; overflow: clip; background: var(--surface); }
  .figures__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .figures__photo figcaption {
    position: absolute; left: 1rem; bottom: 1rem; max-width: calc(100% - 2rem);
    padding: 0.35rem 0.6rem; background: var(--paper); color: var(--ink);
    font-size: var(--step-small);
  }
  .figures__tile { display: grid; align-content: start; gap: 0.75rem; padding: 1.75rem; }
  .figures__tile--1 { background: var(--ink); color: var(--paper); }
  .figures__tile--2 { background: var(--surface); color: var(--ink); }
  .figures__value { font-size: var(--step-head); line-height: 1; letter-spacing: -0.035em; font-weight: 400; }
  .figures__caption { max-width: 22ch; font-size: var(--step-body); line-height: 1.45; }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .figures__photo :global(img) { animation: settle-photo linear both; animation-timeline: view(); animation-range: entry 0% cover 60%; }
      @keyframes settle-photo { from { transform: scale(1.08); } to { transform: scale(1); } }
    }
  }

  @media (max-width: 47.99em) {
    .figures { padding-inline: 0; }
    .figures__title { padding-inline: 1.25rem; }
    .figures__mosaic { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
    .figures__photo { grid-column: 1 / 3; grid-row: auto; aspect-ratio: 4 / 3; max-height: none; }
    .figures__tile { aspect-ratio: 1 / 1; padding: 1rem; }
    .figures__value { font-size: 10vw; }
    .figures__caption { font-size: var(--step-small); max-width: none; }
  }
</style>
