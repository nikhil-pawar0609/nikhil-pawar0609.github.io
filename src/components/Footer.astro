---
import { Picture } from 'astro:assets';
import lakeUnion from '../assets/photos/lake-union-seattle.jpg';
import { person } from '../data/site';
const mail = `mailto:${person.email}?subject=${encodeURIComponent('Hello from your portfolio')}`;
const year = new Date().getFullYear();
---

<footer class="footer">
  <Picture
    class="footer__photo"
    src={lakeUnion}
    formats={['avif', 'webp']}
    widths={[768, 1280, 1920, 2560]}
    sizes="100vw"
    alt="Lake Union at dusk from the north shore, with Seattle’s skyline and the Space Needle against a low sun."
    loading="lazy"
    decoding="async"
  />
  <div class="footer__top">
    <nav aria-label="Footer">
      <ul class="footer__links">
        <li><a class="link" href="#about">About</a></li>
        <li><a class="link" href="#work">Projects</a></li>
        <li><a class="link" href="#experience">Experience</a></li>
        <li><a class="link" href={person.resume}>Résumé</a></li>
      </ul>
    </nav>
    <div class="footer__contact">
      <a class="button button--go" href={mail}>Email me</a>
      <ul class="footer__links">
        <li><a class="link" href={person.linkedin}>LinkedIn</a></li>
        <li><a class="link" href={person.github}>GitHub</a></li>
      </ul>
    </div>
  </div>
  <div class="footer__bottom">
    <p class="footer__name" aria-hidden="true">{person.name}</p>
    <p class="footer__legal">
      © {year} Nikhil Pawar. Photographs:{' '}<a class="link" href="https://commons.wikimedia.org/wiki/File:Pune_West_skyline_-_March_2017.jpg">“Pune West skyline - March 2017”</a>{' '}by Ujjawal.Gayakwad,{' '}<a class="link" href="https://creativecommons.org/licenses/by-sa/4.0">CC BY-SA 4.0</a>;{' '}<a class="link" href="https://commons.wikimedia.org/wiki/File:Lake_Union,_Seattle_(11574424956).jpg">“Lake Union, Seattle”</a>{' '}by Andrew Smith,{' '}<a class="link" href="https://creativecommons.org/licenses/by-sa/2.0">CC BY-SA 2.0</a>; both via Wikimedia Commons, cropped and shown in greyscale under the same licences.
    </p>
  </div>
</footer>

<style>
  .footer {
    position: relative; isolation: isolate; overflow: clip;
    min-height: 100svh; display: grid; grid-template-rows: auto 1fr auto;
    padding: 2rem var(--margin) 1.5rem;
    background: #111; color: var(--paper);
  }
  .footer :global(.footer__photo) {
    position: absolute; inset: 0; z-index: -1;
    width: 100%; height: 100%; object-fit: cover; object-position: 60% 55%;
    filter: brightness(0.55);
  }
  .footer__top { display: flex; justify-content: space-between; align-items: start; gap: 2rem; flex-wrap: wrap; }
  .footer__links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .footer__links a { display: inline-flex; min-height: 2.75rem; align-items: center; }
  .footer__contact { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .footer__bottom { grid-row: 3; display: grid; gap: 1rem; }
  .footer__name {
    font-size: calc((100vw - 2 * var(--margin)) / 4.92); line-height: 1; padding-bottom: 0.12em;
    font-weight: 380; letter-spacing: -0.045em; text-transform: lowercase; white-space: nowrap;
    transform-origin: 0 100%;
  }
  .footer__legal { font-size: var(--step-small); max-width: 110ch; color: var(--paper); }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .footer__name { animation: arrive linear both; animation-timeline: view(); animation-range: entry 20% cover 50%; }
      @keyframes arrive { from { transform: scale(0.94); } to { transform: scale(1); } }
      .footer :global(.footer__photo) { animation: drift linear both; animation-timeline: view(); animation-range: entry 0% exit 100%; }
      @keyframes drift { from { transform: scale(1.08) translateY(-3%); } to { transform: scale(1.08) translateY(3%); } }
    }
  }

  @media (max-width: 40em) {
    .footer { min-height: 88svh; }
    .footer :global(.footer__photo) { object-position: 70% 50%; }
    .footer__top { display: grid; gap: 1rem; }
    .footer__contact { order: -1; }
  }
</style>
